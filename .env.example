# Gere SECRET_KEY e configure as variáveis diretamente na hospedagem.
# Este arquivo é apenas uma referência; a aplicação não carrega .env automaticamente.
GARAGEHUB_ENV=production
SECRET_KEY=
GARAGEHUB_DATA_DIR=/var/data/garagehub
PORT=10000
# Use 1 apenas atrás de um proxy HTTPS confiável, como o Render.
GARAGEHUB_TRUST_PROXY=1
